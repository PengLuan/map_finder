MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=mapgame
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=map_game
JWT_SECRET=change-this-in-production

# 邮箱 SMTP（邮箱验证码登录；与织章主项目共用 QQ 邮箱）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM_NAME=地图寻踪
SMTP_FROM=your-email@qq.com
TIANDITU_KEY=your-tianditu-key
# 高德 Web 服务 Key（用于 scripts/collect_theme_worker.py 地理编码，需「Web服务」类型）
AMAP_WEB_KEY=your-amap-web-key

# 后台管理（/admin 登录；登录后密码本身作为 Bearer Token 使用）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
# 兼容旧配置：访问 /admin/* 接口需在 Header 带 Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-this-admin-token

# 阿里云 OSS（UGC 封面图转存；留空则回退到本地 /static/ugc-covers/）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_COVER_PREFIX=ugc-covers
